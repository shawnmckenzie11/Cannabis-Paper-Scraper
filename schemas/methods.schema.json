{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cannabis-research-navigator.local/schemas/methods.schema.json",
  "title": "CRN Methods Extraction Contract (WP1)",
  "description": "Year-1 methods/context extraction document for Cannabis Research Navigator. Scientific enum meanings are pending_biomedical (Shawn adjudication). Technical: provenance envelope, missingness, IDEAS/SGBA hooks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "provenance",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "wp1.0.0-draft",
        "wp1.1.0-draft",
        "wp1.2.0-draft"
      ],
      "description": "Methods contract version. wp1.0.0-draft records remain valid while wp1.1.0 is in draft."
    },
    "paper_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Foreign key to catalog papers.id. Q7 (Shawn ruling Oct 29 2026, MCK-90): one study = one original research paper (may include multiple arms); study_group_id == paper_id."
    },
    "record_unit": {
      "type": "string",
      "description": "Unit of record = paper (Q7, Oct 29 2026). Multiple arms stay inside one paper-level study.",
      "enum": [
        "paper"
      ],
      "default": "paper"
    },
    "provenance": {
      "$ref": "#/$defs/provenance_envelope"
    },
    "honesty_label": {
      "type": "string",
      "description": "UI-facing honesty chip derived from provenance (technical).",
      "enum": [
        "ai_assisted",
        "human_reviewed",
        "hand_tagged",
        "mixed"
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-field slots. Scientific allowed values pending_biomedical unless noted technical.",
      "properties": {
        "research_type": {
          "$ref": "#/$defs/string_field",
          "description": "In vitro / in vivo / clinical (+ edge cases). Enum pending_biomedical (Q2)."
        },
        "clinical_subtype": {
          "$ref": "#/$defs/string_field",
          "description": "Clinical design subtype when applicable. Enum pending_biomedical (Q3)."
        },
        "product": {
          "$ref": "#/$defs/string_array_field",
          "description": "Product / substance class. Taxonomy pending_biomedical (Q4)."
        },
        "route": {
          "$ref": "#/$defs/string_array_field",
          "description": "Route / administration / exposure modality. Enum pending_biomedical (Q5)."
        },
        "disease_or_experimental_model": {
          "$ref": "#/$defs/string_field",
          "description": "Disease or experimental model. Ontology pending_biomedical (Q6). May be deferred Year-1 (Q1)."
        },
        "outcome_domains": {
          "$ref": "#/$defs/string_array_field",
          "description": "Outcome domains actually studied. Enum pending_biomedical (Q10)."
        },
        "species_or_biological_system": {
          "$ref": "#/$defs/string_field",
          "description": "Species or biological system. Enum pending_biomedical (Q11)."
        },
        "dose_mg": {
          "$ref": "#/$defs/number_field"
        },
        "dose_thc_mg_kg": {
          "$ref": "#/$defs/number_field"
        },
        "dose_cbd_mg_kg": {
          "$ref": "#/$defs/number_field"
        },
        "dose_thc_mg_g": {
          "$ref": "#/$defs/number_field"
        },
        "dose_cbd_mg_g": {
          "$ref": "#/$defs/number_field"
        },
        "conc_thc_mg_ml": {
          "$ref": "#/$defs/number_field"
        },
        "conc_cbd_mg_ml": {
          "$ref": "#/$defs/number_field"
        },
        "conc_thc_uM": {
          "$ref": "#/$defs/number_field"
        },
        "conc_cbd_uM": {
          "$ref": "#/$defs/number_field"
        },
        "pct_thc": {
          "$ref": "#/$defs/number_field"
        },
        "pct_cbd": {
          "$ref": "#/$defs/number_field"
        },
        "puff_count": {
          "$ref": "#/$defs/integer_field"
        },
        "duration_days": {
          "$ref": "#/$defs/number_field"
        },
        "inhaled_exposure_duration": {
          "$ref": "#/$defs/string_field"
        },
        "administration_frequency": {
          "$ref": "#/$defs/string_field"
        },
        "treatment_duration": {
          "$ref": "#/$defs/string_field"
        },
        "repeat_exposure_count": {
          "$ref": "#/$defs/integer_field"
        },
        "exposure_regimen_bin": {
          "$ref": "#/$defs/string_field",
          "description": "Regimen bin label pending_biomedical (Q8)."
        },
        "multiple_doses": {
          "$ref": "#/$defs/boolean_field"
        },
        "multiple_time_intervals": {
          "$ref": "#/$defs/boolean_field"
        },
        "sample_size": {
          "$ref": "#/$defs/integer_field",
          "description": "N as reported; replicate rules pending_biomedical (Q9)."
        },
        "replicates_notes": {
          "$ref": "#/$defs/string_field"
        },
        "strain_reported": {
          "$ref": "#/$defs/string_field"
        },
        "strain_normalized": {
          "$ref": "#/$defs/string_field",
          "description": "Normalized chemotype/mapping pending_biomedical."
        },
        "publication_type": {
          "$ref": "#/$defs/string_field",
          "description": "Catalog publication_type; keep orthogonal to research_type."
        },
        "study_type_legacy": {
          "$ref": "#/$defs/string_array_field",
          "description": "Legacy study_type multi-label for transition only."
        },
        "sgba_sex_reported": {
          "$ref": "#/$defs/string_field",
          "description": "Sex only if explicitly reported. Coding pending_biomedical (Q12). NEVER infer."
        },
        "sgba_gender_reported": {
          "$ref": "#/$defs/string_field",
          "description": "Gender only if explicitly reported (distinct from sex). NEVER infer."
        },
        "sgba_population_age": {
          "$ref": "#/$defs/string_field",
          "description": "Population age only if reported. Coding pending_biomedical (Q12)."
        },
        "sgba_population_descriptors": {
          "$ref": "#/$defs/string_array_field",
          "description": "IDEAS/population descriptors only as reported; no invented taxonomy."
        },
        "sgba_reporting_present": {
          "$ref": "#/$defs/boolean_field",
          "description": "Technical flag: true iff any SGBA+-relevant fact was explicitly present in available source."
        },
        "ideas_representation_notes": {
          "$ref": "#/$defs/string_field",
          "description": "Human-review notes for IDEAS/SGBA+ capture quality; not model invention."
        }
      }
    },
    "legacy_crosswalk": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null",
          "array",
          "object"
        ]
      },
      "description": "Optional snapshot of legacy Scraper column values used as hand-tag fallback for Compare."
    },
    "study_group_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Must equal paper_id (Q7). Equality enforced by contract tests/consumers; JSON Schema cannot compare fields."
    },
    "work_id": {
      "type": "string",
      "minLength": 1,
      "description": "Work grouping key. Preprint/published versions and duplicate records of the same work share one work_id; splits are assigned by work_id. study_group_id stays = paper_id. DOI/title matches across splits are flagged for Methods confirmation, never auto-merged; a confirmed merge requires a new manifest version."
    }
  },
  "$defs": {
    "missingness": {
      "type": "string",
      "description": "Distinct missingness (technical proposal).",
      "enum": [
        "reported",
        "not_in_available_source",
        "source_unavailable",
        "not_applicable",
        "uncertain",
        "extraction_failed"
      ]
    },
    "source_tier": {
      "type": "string",
      "description": "Technical source tier; aligns with content_tiers.py spirit. Truth policy pending_biomedical (Q13).",
      "enum": [
        "pdf_extracted",
        "abstract_reclassify",
        "pdf_link",
        "abstract_only",
        "metadata_only",
        "human_entry",
        "unknown"
      ]
    },
    "provenance_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "extractor_id",
        "model_id",
        "prompt_id",
        "confidence",
        "source_tier",
        "source_span",
        "human_override",
        "reviewed_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "Schema/contract version used for this extraction."
        },
        "extractor_id": {
          "type": "string",
          "description": "Extractor or pipeline component identifier."
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model id when ML/LLM used; null for pure hand tag."
        },
        "prompt_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Prompt or rules_config version id; null if none."
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Extractor confidence when available."
        },
        "source_tier": {
          "$ref": "#/$defs/source_tier"
        },
        "source_span": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional verbatim span or locator grounding the extraction."
        },
        "human_override": {
          "description": "False if none; true or object when a human overrode AI.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "overridden",
                "by"
              ],
              "properties": {
                "overridden": {
                  "type": "boolean"
                },
                "by": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "note": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "ISO-8601 timestamp of human review; null if unreviewed."
        }
      }
    },
    "field_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missingness"
      ],
      "properties": {
        "missingness": {
          "$ref": "#/$defs/missingness"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_biomedical": {
          "type": "boolean",
          "description": "True when value waits Shawn scientific adjudication or open coding.",
          "default": true
        }
      }
    },
    "string_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "missingness"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "description": "Scientific allowed vocabulary pending_biomedical unless missingness != reported."
        },
        "missingness": {
          "$ref": "#/$defs/missingness"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_biomedical": {
          "type": "boolean",
          "default": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "missingness": {
                "const": "reported"
              }
            },
            "required": [
              "missingness"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "string_array_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "missingness"
      ],
      "properties": {
        "value": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Multi-label; vocab pending_biomedical."
        },
        "missingness": {
          "$ref": "#/$defs/missingness"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_biomedical": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "number_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "missingness"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit_as_reported": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unit family as reported; do not silently convert across families (Q8)."
        },
        "missingness": {
          "$ref": "#/$defs/missingness"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_biomedical": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "integer_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "missingness"
      ],
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ]
        },
        "missingness": {
          "$ref": "#/$defs/missingness"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_biomedical": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "boolean_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "missingness"
      ],
      "properties": {
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "missingness": {
          "$ref": "#/$defs/missingness"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_biomedical": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "expert_review": {
      "type": "object",
      "additionalProperties": false,
      "description": "Expert-review form record (wp1.1.0-draft). Audio is NEVER stored: only rationale_text and an optional raw_transcript are persisted. raw_transcript is stored separately and is never treated as the label. Sentry must never receive the transcript or any form field.",
      "required": [
        "review_id",
        "paper_id",
        "study_group_id",
        "source_span",
        "claim_field",
        "claim_value_shown",
        "verdict",
        "reviewer_confidence",
        "rationale_text",
        "raw_transcript",
        "input_mode",
        "stt_model_id",
        "reviewer_id",
        "reviewed_at",
        "schema_version",
        "split_assignment_ref",
        "label_status"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "paper_id": {
          "type": "integer",
          "minimum": 1
        },
        "study_group_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Key grouping duplicates and papers from the same study so they land in the same split. Scientific unit-of-record definition pending_biomedical (Q7, MCK-90).",
          "x-scientific-status": "pending_biomedical"
        },
        "source_span": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to the source passage under review."
        },
        "claim_field": {
          "type": "string",
          "minLength": 1,
          "description": "Which contract field (key under fields) is being reviewed."
        },
        "claim_value_shown": {
          "description": "The value displayed to the reviewer, verbatim."
        },
        "verdict": {
          "type": "string",
          "enum": [
            "agree",
            "disagree",
            "cannot_judge_from_source"
          ],
          "description": "Required; no default. Blank or unclear entries are invalid and must never default to disagree."
        },
        "reviewer_confidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Ordinal scale 1-5 (technical placeholder). Scale anchors/meaning: pending_biomedical.",
          "x-scientific-status": "pending_biomedical"
        },
        "rationale_text": {
          "type": "string",
          "description": "Expert's submitted text (after any transcript edits). This, not raw_transcript, is the review content."
        },
        "raw_transcript": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unedited STT output; nullable; stored separately; never treated as the label."
        },
        "input_mode": {
          "type": "string",
          "enum": [
            "voice",
            "typed"
          ]
        },
        "stt_model_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "STT model identifier when input_mode=voice; null for typed."
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "schema_version": {
          "type": "string",
          "const": "wp1.1.0-draft"
        },
        "split_assignment_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to Evaluation's split manifest entry; assigned before review. Splits are grouped by study_group_id so duplicates/same-study papers share a split."
        },
        "label_status": {
          "type": "string",
          "enum": [
            "review_note"
          ],
          "default": "review_note",
          "description": "Only review_note allowed. gold/training values pending Q16 (Shawn adjudication, MCK-90)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "input_mode": {
                "const": "typed"
              }
            }
          },
          "then": {
            "properties": {
              "raw_transcript": {
                "type": "null"
              },
              "stt_model_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "pending_biomedical": {
      "const": "pending_biomedical",
      "description": "Marker: science value not yet approved by Shawn/PhD expert."
    },
    "reference_value": {
      "type": "object",
      "additionalProperties": false,
      "description": "Dev reference value hand-checked by an expert. Internal only; never guest-visible.",
      "required": [
        "paper_id",
        "field",
        "value",
        "status"
      ],
      "properties": {
        "paper_id": {
          "type": "integer",
          "minimum": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "raw_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "expert_checked"
          ]
        },
        "checked_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "Verified expert identity; required when status=expert_checked."
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "expert_checked"
          }
        }
      },
      "then": {
        "required": [
          "checked_by",
          "checked_at"
        ],
        "properties": {
          "checked_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gold_badge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paper-level gold badge by a verified PhD rater. No audio. Test-split gold lives only in the locked store.",
      "required": [
        "paper_id",
        "rater",
        "timestamp",
        "raw_transcript",
        "submitted_rationale",
        "split",
        "storage"
      ],
      "properties": {
        "paper_id": {
          "type": "integer",
          "minimum": 1
        },
        "rater": {
          "type": "string",
          "minLength": 1,
          "description": "Identity from verified sign-in only."
        },
        "rater_verified": {
          "const": true
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "raw_transcript": {
          "type": "string",
          "description": "Raw transcript text; kept separate from rationale."
        },
        "submitted_rationale": {
          "type": "string",
          "description": "Free text. Format (free comments vs set criteria) is pending_biomedical."
        },
        "rationale_format": {
          "const": "pending_biomedical"
        },
        "split": {
          "enum": [
            "dev",
            "test"
          ]
        },
        "storage": {
          "enum": [
            "locked_store",
            "working_store"
          ]
        }
      },
      "if": {
        "properties": {
          "split": {
            "const": "test"
          }
        }
      },
      "then": {
        "properties": {
          "storage": {
            "const": "locked_store"
          }
        }
      }
    },
    "normalized_field": {
      "type": "object",
      "additionalProperties": false,
      "description": "Normalized field: raw text always kept; normalized value pending_biomedical until approved.",
      "required": [
        "raw_text",
        "normalized_value",
        "normalization_status"
      ],
      "properties": {
        "raw_text": {
          "type": "string"
        },
        "normalized_value": {},
        "normalization_status": {
          "const": "pending_biomedical"
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Id from schemas/normalization_rules.json"
        }
      }
    },
    "work_merge_flag": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-split DOI/title match flagged for Methods confirmation. Never auto-merged.",
      "required": [
        "paper_ids",
        "match_basis",
        "status"
      ],
      "properties": {
        "paper_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "match_basis": {
          "enum": [
            "doi",
            "title"
          ]
        },
        "status": {
          "enum": [
            "flagged",
            "confirmed_merge",
            "rejected"
          ]
        },
        "auto_merged": {
          "const": false
        },
        "new_manifest_version": {
          "type": [
